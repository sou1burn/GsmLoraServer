@startuml
title Компоненты и основные типы

class "main.go" as main <<entry>> {
  + main()
}

package cmd/app {
  class App {
    + DB : *sql.DB
    + DataService : *service.DataService
    + EspConnector : *esp.ESPConnector
    + InitService(connector)
    + InitDB(cfg) : error
    + Close() : error
  }
}

package cmd/server {
  class Server {
    - mutex : sync.Mutex
    - measurementHandler : core.MeasurementHandler
    - connector : esp.Connector
    - waitList : []net.Conn
    - isMeasurementStarted : atomic.Bool
    - monitorOnce : sync.Once
    + MasterState : DeviceStatus
    + SlaveState : DeviceStatus
    + StartServer(port) : error
    + Serve(ln) : error
    + HandleConnection(conn) : error
    + HandleSetSettings(conn, message)
    + HandleGetMeasurementSessions(ctx, conn)
    + HandleAddSession(ctx, conn, session)
    + HandleRemoveSession(ctx, conn, id)
    + HandleEspConnection(conn)
    + SendMasterStatus(status) : error
    + SendSlaveStatus(status) : error
    + StartStatusMonitor()
    + SetSettingsForSession(ctx, params)
  }

  class DeviceStatus {
    + LastUpdated : time.Time
    + Status : string
  }
}

package internal/core {
  interface MeasurementHandler {
    + ProcessPacketData(packet) : error
    + ProcessInterfaceSettingChange(msg) : error
    + GetAllSessions(ctx) : ([]Session, error)
    + SendAllSessions(conn, data) : error
    + SaveSession(ctx, session) : error
    + RemoveSession(ctx, id) : error
    + AddPendingMessage(message, dest, typ)
    + GetAllSessionMeasurements(ctx, id) : ([]Packet, error)
    + SendSessionPackets(id, packets) : error
    + SetSettingsForSession(ctx, params) : error
    + AddClient(conn)
    + RemoveClient(conn)
    + Broadcast(msg) : error
  }
}

package internal/service {
  class DataService {
    - ctx : context.Context
    - packetChan : chan *Packet
    - espConnector : *esp.ESPConnector
    - clients : map[net.Conn]struct{}
    + Repo : Repository
    + PendingMessages : map[reflect.Type]*PendingMessage
    + StartProcessing(ctx)
    - processPackets()
    - processPendingMessages()
    + PendingTick()
    + DrainDataChannel() : error
    + SendPacketToClients(packet)
  }

  interface Repository {
    + Save(ctx, packet, sessionId) : error
    + SaveSession(ctx, session) : error
    + RemoveSession(ctx, id) : error
    + GetAllSessions(ctx) : ([]Session, error)
    + FindBySession(ctx, id) : ([]Packet, error)
    + FindLastSessionId(ctx) : (int, error)
    + CheckSettings(ctx, id) : (bool, bool, error)
    + AddSettingsToSession(ctx, id, sf, tx, bw) : error
  }

  class PendingMessage {
    + Destination : models.Destination
    + Type : handlers.Message
    + Message : string
    + Timestamp : time.Time
  }

  class measurementBuffer {
    packets : []*Packet  (10 шт.)
    deadline : time.Time
  }
}

package internal/esp {
  interface Connector
  class ESPConnector {
    - Conn : net.Conn
    - isConnected : bool
    + CurrentSession : int
    + SetConn(conn)
    + SetConnected(bool)
    + IsConnected() : bool
    + GetCurrentSession() : int
    + SendCommand(command, sessionId) : error
    + SendParamsToDevice(params) : error
  }
}

package internal/handlers {
  class "ParseClientMessage()" as Parse <<function>>
  class PacketParser {
    + ParsePacketData(json) : (Packet, error)
  }
}

package internal/postgres {
  class Repo {
    - db : *sql.DB
  }
  class "Migrate(ctx, db)" as Migrate <<function>>
}

package internal/models {
  class Packet {
    + MeasurementId : int
    + PacketNum : int
    + RSSI : float64
    + SNRL : float64
    + Coordinate : Coordinate
    + Hdop : float32
    + Timestamp : time.Time
  }
  class Coordinate {
    + Latitude : float64
    + Longitude : float64
  }
  class Session {
    + Id : int
    + Name : string
    + StartTime : string
    + EndTime : string
    + Count : int
    + Sf, Tx, Bandwidth : float32
  }
  class Params {
    + Sf, Tx, Bandwidth : float32
  }
}

main --> App
main --> Server
App --> DataService
App --> Repo
App ..> Migrate
Server --> MeasurementHandler
Server --> Connector
Server *-- DeviceStatus
Server ..> Parse
Parse ..> PacketParser
DataService ..|> MeasurementHandler
DataService --> ESPConnector
DataService --> Repository
DataService *-- PendingMessage
DataService ..> measurementBuffer
ESPConnector ..|> Connector
Repo ..|> Repository
Packet *-- Coordinate
Repository ..> Packet
Repository ..> Session
@enduml
