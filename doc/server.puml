@startuml
title Обработка команд интерфейса

actor "Интерфейс" as UI
participant Server
participant "handlers" as H
participant DataService
participant ESPConnector
participant Repo
database Postgres
actor ESP

UI -> Server : строка команды
activate Server
Server -> H : ParseClientMessage(line)
alt ошибка разбора / неизвестная команда
  H --> Server : error / UnknownMessage
  Server --> UI : "ERROR: <текст>"
else разобрано
  H --> Server : Message
end
Server -> DataService : AddClient(conn)

== SET_SETTINGS: SF=..., TX=..., BW=... ==
Server -> Server : isMeasurementStarted = false
alt ESP подключён
  Server -> DataService : ProcessInterfaceSettingChange(msg)
  DataService -> ESPConnector : SendParamsToDevice(params)
  ESPConnector -> ESP : "SET_SETTINGS: SF=..., TX=..., BW=..."
  alt ошибка
    Server --> UI : "ERROR: ..."
  end
else ESP не подключён
  Server -> DataService : AddPendingMessage(SetSettings)
  Server -> Server : addWaitingClient(conn), ждём ESP до 30 с
end

== START_MEASUREMENT: <id> ==
Server -> Server : isMeasurementStarted = true
alt ESP подключён
  Server -> ESPConnector : SendCommand("START_MEASUREMENT", id)
  ESPConnector -> ESPConnector : CurrentSession = id
  ESPConnector -> ESP : "START_MEASUREMENT SESSION_ID=<id>"
  Server ->> DataService : GetAllSessionMeasurements(ctx, id)
  DataService -> Repo : FindBySession(ctx, id)
  Repo -> Postgres : SELECT ... FROM packets
  DataService -->> UI : "MEASUREMENT: [...]" (история сессии, по пакету)
else ESP не подключён
  Server -> DataService : AddPendingMessage(StartMeasurement)
end

== GET_MEASUREMENT_SESSIONS ==
Server ->> DataService : GetAllSessions(ctx)
DataService -> Repo : GetAllSessions(ctx)
Repo -> Postgres : SELECT ... FROM sessions
DataService -->> UI : "SESSIONS: [id, name, start, end, count, sf, bw, tx], ..."
Server --> UI : "MASTER_STATUS ..." / "SLAVE_STATUS ..." (если известны)

== ADD_SESSION / REMOVE_SESSION ==
Server -> DataService : SaveSession(ctx, s) / RemoveSession(ctx, id)
DataService -> Repo : INSERT sessions / DELETE sessions (packets каскадом)
alt ошибка
  Server --> UI : "ERROR: ..."
end
deactivate Server

== Отложенные команды (тикер 10 с) ==
loop каждые 10 с, пока ESP подключён
  DataService -> DataService : PendingTick()
  DataService -> ESPConnector : SendParamsToDevice (SetSettings)
  DataService -> ESPConnector : SendCommand START_MEASUREMENT
  note right of DataService
    порядок: сначала настройки, потом старт;
    успешно отправленная команда удаляется,
    с ошибкой — повторяется на следующем тике
  end note
end

== Отключение клиента ==
Server -> DataService : RemoveClient(conn)
note over Server : ctx соединения отменяется — незавершённые запросы к БД прерываются
@enduml
