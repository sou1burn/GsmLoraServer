@startuml
title Схема БД (db/migrations/00001_init.sql)

hide circle
skinparam linetype ortho

entity sessions {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100)
  * start_time : TIMESTAMP
  end_time : TIMESTAMP
  * count : INTEGER
  * sf : FLOAT = 0
  * bw : FLOAT = 0
  * tx : FLOAT = 0
}

entity packets {
  * id : SERIAL <<PK>>
  --
  * measurement_id : INTEGER
  * packet_num : INTEGER
  * rssi : FLOAT
  * snrl : DOUBLE PRECISION
  * latitude : FLOAT
  * longitude : FLOAT
  * hdop : DOUBLE PRECISION
  * timestamp : VARCHAR(55)
  * session_id : BIGINT <<FK>>
}

sessions ||--o{ packets : "ON DELETE CASCADE"

note right of packets
  INDEX idx_packets_session_measurement
    (session_id, measurement_id)

  timestamp хранится строкой в формате
  models.TimeLayout ("2006-01-02 15:04:05.999999999 -0700 MST")
end note

note left of sessions
  count — число уникальных measurement_id сессии.
  Поддерживается триггером increment_session_count
  (AFTER INSERT OR DELETE ON packets →
  update_session_count()).

  sf / bw / tx = 0 — настройки ещё не заданы
  (заполняются по ACK: SSET от ESP).
end note

legend bottom
  Миграции goose применяются при старте: app.InitDB → postgres.Migrate.
  Все запросы репозитория выполняются с context.Context.
endlegend
@enduml
